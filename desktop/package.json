{
  "name": "capwizard-desktop",
  "version": "0.2.0-alpha.2",
  "description": "CapWizard — desktop app (Electron shell + Python sidecar)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:backend": "scripts/build-backend.sh",
    "dist": "npm run build:backend && electron-builder --mac --arm64"
  },
  "author": "Nicola Preda",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.predanicola.capwizard",
    "productName": "CapWizard",
    "files": [
      "electron/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend"
      },
      {
        "from": "../skill",
        "to": "skill",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "artifactName": "CapWizard-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js"
  }
}
